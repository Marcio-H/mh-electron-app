{
  "name": "mh-electron-app",
  "productName": "mh-electron-app",
  "version": "1.0.0",
  "description": "Electron app",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "npm run start:debug",
    "start:debug": "cross-env APP_ENV=debug electron-forge start",
    "package": "npm run package:debug",
    "package:debug": "cross-env APP_ENV=debug electron-forge package",
    "make": "npm run make:debug",
    "make:debug": "cross-env APP_ENV=debug electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": {
    "name": "Marcio-H",
    "email": "marciojr.arc@hotmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "cross-env": "^10.1.0",
    "css-loader": "^6.11.0",
    "electron": "43.4.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "prettier": "^3.9.6",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "~4.5.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
